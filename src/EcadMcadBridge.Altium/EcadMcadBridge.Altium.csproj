<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>EcadMcadBridge.Altium</RootNamespace>
    <AssemblyName>EcadMcadBridge</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EcadMcadBridge.Core\EcadMcadBridge.Core.csproj" />
  </ItemGroup>

  <!-- Altium provides these assemblies at runtime; they are referenced, never copied or committed. -->
  <ItemGroup>
    <Reference Include="Altium.SDK">
      <HintPath>$(AltiumSdkDir)\Altium.SDK.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Altium.SDK.Interfaces">
      <HintPath>$(AltiumSdkDir)\Altium.SDK.Interfaces.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="Installation\EcadMcadBridge.ins" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Installation\EcadMcadBridge.rcs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Altium's legacy .ins/.rcs parser expects CRLF; source files are LF in Git. -->
  <Target Name="NormalizeInstallationLineEndings" AfterTargets="Build">
    <ItemGroup>
      <InstallationFile Include="Installation\*.ins;Installation\*.rcs" />
    </ItemGroup>
    <WriteLinesToFile File="$(OutDir)Installation\%(InstallationFile.Filename)%(InstallationFile.Extension)"
                      Lines="$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('%(InstallationFile.FullPath)')), '\r?\n', '&#13;&#10;'))"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
