<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>EcadMcadBridge.SolidWorks.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EcadMcadBridge.SolidWorks\EcadMcadBridge.SolidWorks.csproj" />
  </ItemGroup>

  <!-- Local-only interop resolution for the test host if a type is inspected. -->
  <Target Name="CopySolidWorksInteropForTests" AfterTargets="Build" Condition="'$(SolidWorksApiDir)' != ''">
    <ItemGroup>
      <TestInterop Include="$(SolidWorksApiDir)\SolidWorks.Interop.sldworks.dll" />
      <TestInterop Include="$(SolidWorksApiDir)\SolidWorks.Interop.swconst.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(TestInterop)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
